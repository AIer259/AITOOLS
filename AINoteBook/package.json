{
  "name": "ainotebook",
  "private": true,
  "version": "0.1.0",
  "description": "本地优先的精简 Markdown 笔记应用，支持复杂表格、着重块、图片、嵌套文档与 PDF 导出。",
  "license": "MIT",
  "author": "AIer259",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIer259/AITOOLS.git",
    "directory": "AINoteBook"
  },
  "homepage": "https://github.com/AIer259/AITOOLS/tree/main/AINoteBook#readme",
  "bugs": {
    "url": "https://github.com/AIer259/AITOOLS/issues"
  },
  "keywords": [
    "notes",
    "markdown",
    "local-first",
    "tiptap",
    "react",
    "indexeddb",
    "pdf"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
